# Required: Gemini feedback
GEMINI_API_KEY=replace_with_your_gemini_api_key

# Optional: used as a fallback key after a failed Gemini attempt
GEMINI_API_KEY_2=
GEMINI_MODEL=gemini-2.5-flash-lite
RETRY_DELAY=2
MAX_RETRIES=3

# Optional for public Hugging Face models; required if repository access changes
IELTS_HUGGINGFACE_API_KEY=
HF_HUB_DISABLE_SYMLINKS_WARNING=1

# Optional persistence for final reports
MONGO_URI=

# API and LangGraph
PORT=8000
LANGGRAPH_CHECKPOINT_DB=data/langgraph_checkpoints.sqlite
LANGGRAPH_STRICT_MSGPACK=true

# OpenTelemetry tracing is disabled by default
OTEL_SDK_DISABLED=true
OTEL_SERVICE_NAME=ielts-writing-agent
OTEL_RESOURCE_ATTRIBUTES=service.version=1.1.0,deployment.environment.name=local
OTEL_TRACES_EXPORTER=console
OTEL_TRACES_SAMPLER=parentbased_always_on

# Used only when OTEL_TRACES_EXPORTER=otlp
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces

# Legacy Ollama/Llama settings - disabled in the current implementation
# OLLAMA_CHAT_ENDPOINT=http://localhost:11434/api/chat
# OLLAMA_GEN_ENDPOINT=http://localhost:11434/api/generate
